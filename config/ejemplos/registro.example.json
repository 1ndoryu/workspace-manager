{
  "version": 1,
  "proyectos": [
    {
      "id": "proyecto-1",
      "ruta": ".",
      "dominio": "workspace.localhost",
      "boton": [
        [
          "node",
          "dist-server/server/index.js"
        ],
        [
          "npm",
          "run",
          "dev",
          "--",
          "--port",
          "5175",
          "--strictPort"
        ]
      ],
      "tipoLauncher": "backend = servidor COMPILADO en un solo proceso node (dist-server/, rebuild con npm run build:server; tsx/cli abria consola visible en su worker hijo) + front directo sin npm/cmd via resolverDirecto; reinicio tras cambios con stop+up",
      "puertos": [
        8787,
        5175
      ],
      "healths": [
        {
          "puerto": 8787,
          "ruta": "/api/pc/estado",
          "esperaJson": true
        },
        {
          "puerto": 5175,
          "ruta": "/",
          "esperaJson": false
        }
      ],
      "timeoutMs": 3000,
      "arranqueMs": 60000,
      "expectedCmdline": [
        "dist-server",
        "5175"
      ],
      "requiere": [
        "proyecto-2"
      ],
      "comandos": {
        "gate": "DISPLAY=:99 TMPDIR=/var/tmp npm run quality:check",
        "typecheck": "npm run type-check",
        "build": "npm run build",
        "test-archivo": "node node_modules/tsx/dist/cli.mjs --test <archivo>"
      }
    },
    {
      "id": "proyecto-2",
      "ruta": "../proyecto-rust",
      "dominio": "rust.localhost",
      "boton": [
        [
          "<TMP>\\target\\app-main\\debug\\app.exe"
        ]
      ],
      "puertos": [
        3000
      ],
      "healths": [
        {
          "puerto": 3000,
          "ruta": "/health",
          "esperaJson": true
        }
      ],
      "timeoutMs": 3000,
      "arranqueMs": 180000,
      "expectedCmdline": "app",
      "env": {
        "SCCACHE_BASEDIRS": "<RAIZ_AREA>"
      },
      "tipoLauncher": "binario directo (el exe vive en target por rama <TMP>\\target\\app-<rama> [05AA-1]; si falta, `up` lo reconstruye solo vía `reconstruir`; requiere <TOKEN_API> de al menos 32 caracteres en el entorno, en local vale cualquiera, el real solo vive en el gestor de despliegues)",
      "reconstruir": {
        "manifest": "app/Cargo.toml",
        "targetDir": "<TMP>\\target\\app-main"
      },
      "comandos": {
        "gate": null,
        "typecheck": null,
        "build": null,
        "test-archivo": null
      }
    },
    {
      "id": "proyecto-3",
      "ruta": "../proyecto-web",
      "dominio": "web.localhost",
      "boton": [
        [
          "npm",
          "run",
          "dev:back"
        ],
        [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "dev",
          "--",
          "--port",
          "5201",
          "--strictPort"
        ],
        [
          "npm",
          "run",
          "dev:gateway"
        ]
      ],
      "puertos": [
        3101,
        5201,
        3103
      ],
      "procesosAceptados": {
        "puertos": [
          3101,
          5201,
          3103
        ],
        "motivo": "dev mantenido a proposito en el portatil; declararlo evita que el doctor lo tome por un proceso suelto"
      },
      "healths": [
        {
          "puerto": 3101,
          "ruta": "/api/health",
          "esperaJson": true
        },
        {
          "puerto": 5201,
          "ruta": "/",
          "esperaJson": false
        },
        {
          "puerto": 3103,
          "ruta": "/health",
          "esperaJson": true
        },
        {
          "puerto": 20241,
          "ruta": "/ready",
          "esperaJson": true
        }
      ],
      "timeoutMs": 3000,
      "arranqueMs": 300000,
      "expectedCmdline": [
        "app-backend",
        "proyecto-web\\frontend",
        "gateway"
      ],
      "env": {
        "PORT": "3101"
      },
      "host": "<ALIAS_SSH>",
      "envRemoto": [
        "DATABASE_URL",
        "JWT_SECRET",
        "HOST",
        "PORT",
        "UPLOAD_DIR",
        "RUST_LOG",
        "PUBLIC_BASE_URL",
        "<CLAVE_API>",
        "VITE_DEV_EMAIL",
        "VITE_DEV_PASSWORD"
      ],
      "precompilar": [
        [
          "cargo",
          "build",
          "--bin",
          "app-backend"
        ]
      ],
      "dependencias": [
        "frontend",
        "gateway"
      ],
      "puertosRemotos": [
        3101,
        5201,
        20241
      ],
      "tunelesExtra": [
        [
          33101,
          3101
        ]
      ],
      "tunelSsh": false,
      "hostsPublicos": [
        "web-dev.<DOMINIO_BASE>"
      ],
      "puertosPublicos": [
        3101
      ],
      "buildMode": "builder",
      "botonRemoto": [
        [
          "env",
          "PUBLIC_BASE_URL=https://web-dev.<DOMINIO_BASE>/rust",
          "cargo",
          "run",
          "--bin",
          "app-backend"
        ],
        [
          "env",
          "VITE_API_URL=/rust",
          "WEB_DEV_PUBLIC_HOST=web-dev.<DOMINIO_BASE>",
          "npm",
          "--prefix",
          "frontend",
          "run",
          "dev",
          "--",
          "--port",
          "5201",
          "--strictPort",
          "--host",
          "127.0.0.1"
        ],
        [
          "sh",
          "-c",
          "set -a; . <HOME_REMOTO>/.config/cloudflared/web-dev.env; set +a; exec <HOME_REMOTO>/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 run"
        ]
      ],
      "auxiliares": [
        {
          "puerto": 3122,
          "marcador": "<MARCADOR_DEL_AUXILIAR>",
          "motivo": "auxiliar de desarrollo: proceso propio fuera del mando (script o binario)"
        },
        {
          "puerto": 3103,
          "marcador": "<MARCADOR_DEL_AUXILIAR>",
          "motivo": "servicio auxiliar que se mantiene fuera del mando (p. ej. un gateway con sesiones propias)"
        }
      ],
      "tipoLauncher": "plantilla con wrapper run-with-db.mjs: backend en <TMP> + Vite bajo ruta; PORT por env del mando; front via --prefix+-- para que --port llegue a vite",
      "comandos": {
        "gate": null,
        "typecheck": "cargo check",
        "build": null,
        "test-archivo": "node scripts/run-with-db.mjs test --test <archivo>"
      },
      "modo": "build",
      "build": {
        "puertos": [
          3101,
          20241
        ],
        "boton": [
          [
            "env",
            "STATIC_DIR=frontend/dist",
            "PUBLIC_BASE_URL=https://web-dev.<DOMINIO_BASE>",
            "cargo",
            "run",
            "--bin",
            "app-backend"
          ],
          [
            "sh",
            "-c",
            "set -a; . <HOME_REMOTO>/.config/cloudflared/web-dev.env; set +a; exec <HOME_REMOTO>/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 run"
          ]
        ],
        "construirFront": [
          [
            "npm",
            "--prefix",
            "frontend",
            "run",
            "build"
          ]
        ],
        "healths": [
          {
            "puerto": 3101,
            "ruta": "/",
            "marcador": "<title>Proyecto Web"
          },
          {
            "puerto": 20241,
            "ruta": "/ready",
            "esperaJson": true
          }
        ]
      }
    }
  ],
