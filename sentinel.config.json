{
  "schemaVersion": 2,
  "mode": "enforce",
  "budgets": {
    "mode": "enforce"
  },
  "project": {
    "primaryBranch": "main"
  },
  "guard": {
    "directCommands": {
      "npmScripts": ["lint", "test", "build", "check"],
      "npxTools": ["eslint", "tsc", "typescript", "vitest"],
      "cargoSubcommands": [],
      "tools": ["tsc", "vitest", "eslint"]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "node",
      "config": {
        "includePatterns": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.css"],
        "excludePatterns": ["**/node_modules/**", "**/dist/**", "**/dist-server/**", "**/build/**", "**/.git/**", "**/data/**"],
        "directoryExceptions": [],
        "portableBoundaries": {},
        "rules": {},
        "runtime": {
          "minimumVersion": "",
          "protocolVersion": 0,
          "lockFile": ""
        }
      }
    }
  }
}
