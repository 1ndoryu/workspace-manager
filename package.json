{
  "name": "workspace-manager",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/1ndoryu/workspace-manager.git"
  },
  "type": "module",
  "description": "Gestor del area de trabajo: control de proyectos, estado Git/Sentinel/VarSense/roadmap, mapa isometrico y gestion de AGENTS.md y skills.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "server": "tsx watch --env-file-if-exists=logs/.tareas-env src/server/index.ts",
    "server:compilado": "node dist-server/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "diagnostico": "tsx scripts/diagnostico-escaner.ts",
    "sync:gate": "tsx scripts/sync-gate/sync-gate-schema.mjs",
    "sync:quality": "tsx scripts/quality-sync/quality-sync.mjs",
    "check": "npm run check:version && npm run type-check",
    "test": "node scripts/dev/ejecutar-tests.mjs npx tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "quality:doctor": "node scripts/quality/doctor.mjs --json",
    "quality:setup": "node scripts/quality/quality-setup.mjs",
    "quality:lock": "node scripts/quality/lock-generator.mjs",
    "quality:lock:check": "node scripts/quality/lock-generator.mjs",
    "quality:bump": "node scripts/quality/bump.mjs",
    "quality:bump:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality/bump.test.mjs",
    "quality:setup:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality/quality-setup.test.mjs",
    "quality:sync:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality-sync/quality-sync.test.mjs",
    "quality:cert:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality/certificacion.test.mjs",
    "privacidad": "node scripts/dev/privacidad/privacidad.mjs",
    "privacidad:historial": "node scripts/dev/privacidad/privacidad.mjs --historial",
    "privacidad:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/dev/privacidad/privacidad.test.mjs",
    "prepare": "node scripts/dev/privacidad/activar-hooks.mjs",
    "build:app": "node scripts/dev/dev.mjs app workspace-manager",
    "check:app": "node scripts/run-cargo.mjs xwin check --target x86_64-pc-windows-msvc --prepath=/usr/lib/llvm-18/bin",
    "gate:app": "node scripts/run-cargo.mjs clippy --target x86_64-pc-windows-msvc --prepath=/usr/lib/llvm-18/bin -- -D warnings",
    "check:version": "node scripts/app/version.mjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "source-map-js": ">=1.2.2"
  }
}
