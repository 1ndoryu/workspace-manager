{
  "name": "workspace-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestor del area de trabajo: control de proyectos, estado Git/Sentinel/VarSense/roadmap, mapa isometrico y gestion de AGENTS.md y skills.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "server": "tsx watch src/server/index.ts",
    "diagnostico": "tsx scripts/diagnostico-escaner.ts",
    "sync:gate": "tsx scripts/sync-gate-schema.mjs",
    "sync:quality": "tsx scripts/quality-sync.mjs",
    "check": "npm run type-check"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
