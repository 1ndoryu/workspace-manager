{
  "name": "workspace-manager",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/1ndoryu/workspace-manager.git" },
  "type": "module",
  "description": "Gestor del area de trabajo: control de proyectos, estado Git/Sentinel/VarSense/roadmap, mapa isometrico y gestion de AGENTS.md y skills.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "server": "tsx watch src/server/index.ts",
    "server:compilado": "node dist-server/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "diagnostico": "tsx scripts/diagnostico-escaner.ts",
    "sync:gate": "tsx scripts/sync-gate-schema.mjs",
    "sync:quality": "tsx scripts/quality-sync.mjs",
    "check": "npm run type-check",
    "quality:doctor": "sentinel doctor --json",
    "quality:setup": "node scripts/quality/quality-setup.mjs",
    "quality:lock": "node scripts/quality/lock-generator.mjs",
    "quality:lock:check": "node scripts/quality/lock-generator.mjs",
    "quality:bump": "node scripts/quality/bump.mjs",
    "quality:bump:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality/bump.test.mjs",
    "quality:setup:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality/quality-setup.test.mjs",
    "quality:sync:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality-sync.test.mjs",
    "quality:cert:test": "node scripts/dev/ejecutar-tests.mjs node --test scripts/quality/certificacion.test.mjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "source-map-js": ">=1.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
